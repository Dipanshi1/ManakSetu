# -------------------------------------------------------
# Application
# -------------------------------------------------------
APP_ENV=development          # development | production
APP_DEBUG=true
APP_PORT=8000

# -------------------------------------------------------
# Database (PostgreSQL + pgvector)
# -------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sih26108

# -------------------------------------------------------
# Document storage
# -------------------------------------------------------
UPLOAD_DIR=./uploads         # local disk for dev; swap for S3 bucket in prod
ANALYSIS_DATABASE_PATH=./data/sih26108.db

# -------------------------------------------------------
# AI / LLM
# -------------------------------------------------------
# Set whichever provider the ML team decides on.
# Only one of these needs to be set.
OPENAI_API_KEY=
GOOGLE_API_KEY=              # Gemini

# If AI/ML team deploys as a separate HTTP service:
# AIML_SERVICE_URL=http://localhost:8001
AIML_TIMEOUT_SECONDS=8
# Set true only after the SentenceTransformer model has been downloaded locally.
SEMANTIC_RETRIEVAL_ENABLED=false

# -------------------------------------------------------
# Bhashini (multilingual — low priority, wire in later)
# -------------------------------------------------------
BHASHINI_API_KEY=
BHASHINI_USER_ID=
ENABLE_BIS_SYNC=true

# -------------------------------------------------------
# Email / Report Webhook
# -------------------------------------------------------
N8N_REPORT_WEBHOOK_URL=
